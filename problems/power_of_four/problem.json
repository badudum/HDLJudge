  ],
  "constraints": [
    "`p4 = 1` exactly when `x` is a power of four (1, 4, 16, …, 16384).",
    "Purely combinational. No loops or generate, no `$countones` / `$onehot`."
  ],
  "hints": [
    "A power of four is a power of two whose single 1 sits in an **even** bit position.",
    "Power of two: `x != 0 && (x & (x - 1)) == 0`.",
    "Even positions: mask with `16'h5555`."
  ],
  "examples": [
    {
      "check": "powers of four",
      "title": "16",
      "input": "x = 16",
      "expected": "p4 = 1"
    },
    {
      "check": "other powers of two",
      "title": "8",
      "input": "x = 8",
      "expected": "p4 = 0"
    }
  ],
  "synthesis": "required",
