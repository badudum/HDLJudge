  "constraints": [
    "Unsigned saturating addition: `y = min(a + b, 255)`.",
    "**Branchless:** no `?:`, `if`, `case` or comparisons."
  ],
  "hints": [
    "Add in 9 bits: the carry out says 'overflow'.",
    "OR the 8-bit sum with a mask made of copies of the carry: `s[7:0] | {8{s[8]}}`."
  ],
  "examples": [
    {
      "check": "corner cases",
      "title": "overflow",
      "input": "a = 200, b = 100",
      "expected": "y = 255"
    },
    {
      "check": "corner cases",
      "title": "no overflow",
      "input": "a = 100, b = 100",
      "expected": "y = 200"
    }
  ],
