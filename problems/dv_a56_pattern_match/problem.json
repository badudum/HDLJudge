{
  "id": 147,
  "title": "Assertion: Sync Pattern Locks",
  "difficulty": "Medium",
  "category": "verification",
  "kind": "checker",
  "simulator": "verilator",
  "tags": [
    "sva",
    "assertions",
    "checker"
  ],
  "top": "chk_sync",
  "synthesis": "none",
  "languages": [
    "systemverilog"
  ],
  "ports": [
    {
      "name": "clk",
      "dir": "input",
      "width": 1
    },
    {
      "name": "rst",
      "dir": "input",
      "width": 1
    },
    {
      "name": "din",
      "dir": "input",
      "width": 1
    },
    {
      "name": "lock",
      "dir": "input",
      "width": 1
    }
  ],
  "constraints": [
    "Whenever the serial input `din` shows the pattern 1, 1, 0, 1 on four consecutive samples, `lock` must be high on the next cycle.",
    "Report a violation with a failing assertion (or `$error`). Legal traces must produce no error. `rst` is active high; ignore everything while it is asserted."
  ],
  "hints": [
    "A sequence as the antecedent: `din ##1 din ##1 !din ##1 din |=> lock`.",
    "Overlapping patterns each trigger their own check."
  ],
  "examples": [
    {
      "check": "legal: lock follows the pattern",
      "title": "ok",
      "input": "din = 1101, lock the next cycle",
      "expected": "no failure"
    },
    {
      "check": "violation: no lock",
      "title": "missed",
      "input": "din = 1101, lock stays 0",
      "expected": "assertion fails"
    },
    {
      "check": "legal: near miss",
      "title": "1001",
      "input": "din = 1001",
      "expected": "no obligation"
    }
  ]
}
