{
  "id": 105,
  "title": "Assertion: Rise Then Fall",
  "difficulty": "Medium",
  "category": "verification",
  "kind": "checker",
  "simulator": "verilator",
  "tags": [
    "sva",
    "assertions",
    "checker"
  ],
  "top": "chk_pulse_width",
  "synthesis": "none",
  "languages": [
    "systemverilog"
  ],
  "ports": [
    {
      "name": "clk",
      "dir": "input",
      "width": 1
    },
    {
      "name": "rst",
      "dir": "input",
      "width": 1
    },
    {
      "name": "a",
      "dir": "input",
      "width": 1
    }
  ],
  "constraints": [
    "Rule: whenever `a` rises, it must fall again 2 to 4 cycles later (a pulse 2–4 cycles wide).",
    "Report a violation with a failing assertion (or `$error`). Legal traces must produce no error. `rst` is active high; ignore everything while it is asserted."
  ],
  "hints": [
    "`$rose(a) |-> ##[2:4] $fell(a)`.",
    "Check both limits: a 1-cycle pulse and a 5-cycle pulse must fail.",
    "The window is counted from the rising cycle: `##2` is two cycles later."
  ],
  "examples": [
    {
      "check": "legal: 3-cycle pulse",
      "title": "in range",
      "input": "a = 01110",
      "expected": "no failure"
    },
    {
      "check": "violation: 1-cycle pulse",
      "title": "too short",
      "input": "a = 0100",
      "expected": "assertion fails"
    },
    {
      "check": "violation: 5-cycle pulse",
      "title": "too long",
      "input": "a = 0111110",
      "expected": "assertion fails"
    }
  ]
}
