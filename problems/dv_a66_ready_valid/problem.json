{
  "id": 154,
  "title": "Assertion: Ready/Valid Handshake Rules",
  "difficulty": "Medium",
  "category": "verification",
  "kind": "checker",
  "simulator": "verilator",
  "tags": [
    "sva",
    "assertions",
    "checker"
  ],
  "top": "chk_rv",
  "synthesis": "none",
  "languages": [
    "systemverilog"
  ],
  "ports": [
    {
      "name": "clk",
      "dir": "input",
      "width": 1
    },
    {
      "name": "rst",
      "dir": "input",
      "width": 1
    },
    {
      "name": "valid",
      "dir": "input",
      "width": 1
    },
    {
      "name": "ready",
      "dir": "input",
      "width": 1
    },
    {
      "name": "data",
      "dir": "input",
      "width": 8
    }
  ],
  "constraints": [
    "Rule 1: once `valid` is high, it must stay high until a transfer (`valid && ready`) happens. Rule 2: `data` must not change while `valid && !ready`.",
    "Report a violation with a failing assertion (or `$error`). Legal traces must produce no error. `rst` is active high; ignore everything while it is asserted."
  ],
  "hints": [
    "`valid && !ready |=> valid && $stable(data)` covers both rules at once.",
    "A sender may drop `valid` in the cycle right after a transfer."
  ],
  "examples": [
    {
      "check": "legal: wait states",
      "title": "ok",
      "input": "valid held 3 cycles until ready",
      "expected": "no failure"
    },
    {
      "check": "violation: valid withdrawn",
      "title": "withdrawn",
      "input": "valid drops before ready",
      "expected": "assertion fails"
    },
    {
      "check": "violation: data changed",
      "title": "changed",
      "input": "data changes while waiting",
      "expected": "assertion fails"
    }
  ]
}
