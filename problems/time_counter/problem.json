  ],
  "constraints": [
    "Each rising edge with `tick_ms = 1` advances the time by one millisecond: ms 0 … 999, sec 0 … 59, min 0 … 59, hr 0 … 23, wrapping 23:59:59.999 → 00:00:00.000.",
    "`load = 1` sets all four fields from `ld_*` on that edge (priority over `tick_ms`). Loaded values are always legal.",
    "Synchronous reset clears everything. Must be synthesizable."
  ],
  "hints": [
    "A cascade of four counters: each one advances only when all the counters below it wrap.",
    "Carry conditions: `ms == 999`, then also `sec == 59`, then `min == 59`.",
    "Resist building one giant binary counter plus dividers: the cascade is smaller and much easier to verify."
  ],
  "examples": [
    {
      "check": "rollover of seconds",
      "title": "second",
      "input": "time 00:00:00.999, one tick",
      "expected": "00:00:01.000"
    },
    {
      "check": "rollover of the day",
      "title": "midnight",
      "input": "time 23:59:59.999, one tick",
      "expected": "00:00:00.000"
    },
    {
      "check": "load",
      "title": "load",
      "input": "load 12:34:56.789",
      "expected": "fields show exactly that"
    }
  ],
  "synthesis": "required",
  "languages": [
    "verilog",
    "systemverilog",
    "vhdl"
  ]
}
