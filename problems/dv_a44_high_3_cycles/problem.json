{
  "id": 100,
  "title": "Assertion: Enable Held for 3 Cycles",
  "difficulty": "Easy",
  "category": "verification",
  "kind": "checker",
  "simulator": "verilator",
  "tags": [
    "sva",
    "assertions",
    "checker"
  ],
  "top": "chk_hold3",
  "synthesis": "none",
  "languages": [
    "systemverilog"
  ],
  "ports": [
    {
      "name": "clk",
      "dir": "input",
      "width": 1
    },
    {
      "name": "rst",
      "dir": "input",
      "width": 1
    },
    {
      "name": "en",
      "dir": "input",
      "width": 1
    }
  ],
  "constraints": [
    "Rule: whenever `en` rises, it must stay high for **at least 3 consecutive cycles** (including the cycle it rose).",
    "Report a violation with a failing assertion (or `$error`). Legal traces must produce no error. `rst` is active high; ignore everything while it is asserted."
  ],
  "hints": [
    "Consecutive repetition: `en[*3]`.",
    "`$rose(en) |-> en[*3]`.",
    "Longer pulses are fine: only the first three cycles are required."
  ],
  "examples": [
    {
      "check": "legal: 3-cycle pulse",
      "title": "3 cycles",
      "input": "en = 0111000",
      "expected": "no failure"
    },
    {
      "check": "violation: 2-cycle pulse",
      "title": "too short",
      "input": "en = 0110000",
      "expected": "assertion fails"
    },
    {
      "check": "legal: long pulse",
      "title": "long",
      "input": "en = 01111110",
      "expected": "no failure"
    }
  ]
}
