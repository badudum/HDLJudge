{
  "id": 144,
  "title": "Assertion: Value Within Range",
  "difficulty": "Medium",
  "category": "verification",
  "kind": "checker",
  "simulator": "verilator",
  "tags": [
    "sva",
    "assertions",
    "checker"
  ],
  "top": "chk_range",
  "synthesis": "none",
  "languages": [
    "systemverilog"
  ],
  "ports": [
    {
      "name": "clk",
      "dir": "input",
      "width": 1
    },
    {
      "name": "rst",
      "dir": "input",
      "width": 1
    },
    {
      "name": "valid",
      "dir": "input",
      "width": 1
    },
    {
      "name": "temp",
      "dir": "input",
      "width": 8
    }
  ],
  "constraints": [
    "Rule: whenever `valid = 1`, `temp` must lie in 10 … 90 inclusive. When `valid = 0`, `temp` is don't-care.",
    "Report a violation with a failing assertion (or `$error`). Legal traces must produce no error. `rst` is active high; ignore everything while it is asserted."
  ],
  "hints": [
    "`valid |-> temp inside {[10:90]}`.",
    "Both bounds are inclusive: 10 and 90 are legal, 9 and 91 are not."
  ],
  "examples": [
    {
      "check": "legal: values in range",
      "title": "in range",
      "input": "valid with temp = 10, 55, 90",
      "expected": "no failure"
    },
    {
      "check": "violation: too high",
      "title": "too high",
      "input": "valid with temp = 91",
      "expected": "assertion fails"
    },
    {
      "check": "legal: out-of-range while invalid",
      "title": "don't care",
      "input": "temp = 200 with valid = 0",
      "expected": "no failure"
    }
  ]
}
